<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earthy_dark_background">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_verifyEmail"
        android:layout_width="212dp"
        android:layout_height="48dp"
        android:layout_margin="32dp"
        android:background="@drawable/rounded_button"
        android:backgroundTint="@color/earthy_dark_on_secondary"
        android:fontFamily="@font/inter"
        android:text="@string/verifyEmailOption"
        android:textAllCaps="false"
        android:textColor="@color/earthy_dark_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.927" />

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/swoopr_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.427"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.388"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_get_started"
        android:layout_width="261dp"
        android:layout_height="67dp"
        android:layout_margin="32dp"
        android:background="@drawable/rounded_button"
        android:backgroundTint="@color/earthy_dark_primary"
        android:fontFamily="@font/workforce_sans"
        android:text="@string/get_started"
        android:textAllCaps="false"
        android:textColor="@color/earthy_dark_on_primary"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.771" />

</androidx.constraintlayout.widget.ConstraintLayout>