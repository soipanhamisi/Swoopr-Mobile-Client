<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earthy_dark_background"
    android:padding="24dp"
    tools:context=".RegisterVehicleActivity">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Register Vehicle"
        android:textColor="@color/earthy_dark_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_reg_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="Registration Number (e.g. KAA 123A)"
        android:textColorHint="@color/earthy_dark_text_secondary"
        app:hintTextColor="@color/earthy_dark_primary"
        app:boxStrokeColor="@color/earthy_dark_primary"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_reg_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/earthy_dark_text_primary"
            android:inputType="textCapCharacters" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Description (e.g. Silver Toyota Noah)"
        android:textColorHint="@color/earthy_dark_text_secondary"
        app:hintTextColor="@color/earthy_dark_primary"
        app:boxStrokeColor="@color/earthy_dark_primary"
        app:layout_constraintTop_toBottomOf="@id/til_reg_no">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/earthy_dark_text_primary"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btn_register_vehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Register Vehicle"
        android:backgroundTint="@color/earthy_dark_primary"
        android:textColor="@color/earthy_dark_on_primary"
        app:layout_constraintTop_toBottomOf="@id/til_desc" />


</androidx.constraintlayout.widget.ConstraintLayout>
