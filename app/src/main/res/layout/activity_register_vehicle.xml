<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_green_bg"
    tools:context=".RegisterVehicleActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottie_gps"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:lottie_rawRes="@raw/gps_navigation"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Register Your Vehicle Here..."
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/et_reg_no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/registration_input_background"
                android:hint="Number plate info..."
                android:padding="16dp"
                android:textColor="@android:color/black"
                android:textColorHint="#707070"
                android:layout_marginBottom="16dp"
                android:inputType="textCapCharacters"/>

            <EditText
                android:id="@+id/et_desc"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/registration_input_background"
                android:hint="vehicle description..."
                android:padding="16dp"
                android:gravity="top"
                android:textColor="@android:color/black"
                android:textColorHint="#707070"
                android:layout_marginBottom="32dp"
                android:inputType="textMultiLine"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_register_vehicle"
                android:layout_width="200dp"
                android:layout_height="60dp"
                android:background="@drawable/registration_button_background"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="@color/dashboard_green_bg"
                android:textSize="20sp"
                android:layout_marginBottom="48dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/nav_home"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:contentDescription="Home"/>

        <ImageView
            android:id="@+id/nav_calendar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Calendar"/>

        <ImageView
            android:id="@+id/nav_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:contentDescription="Profile"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
