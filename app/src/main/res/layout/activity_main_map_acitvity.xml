<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earthy_dark_background"
    tools:context=".MainMapActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">



        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:text="@string/trip_hint_select_action"
            android:textColor="@color/earthy_dark_text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_selection_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text=""
            android:textColor="@color/earthy_dark_primary"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_hint" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_fragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/earthy_dark_surface"
            android:contentDescription="My Location"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="@color/earthy_dark_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_confirm_selection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/earthy_dark_primary"
            android:text="@string/trip_confirm_button"
            android:textColor="@color/earthy_dark_on_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Sheet -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="145dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/ll_sheet_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/drag_handle"
                android:layout_width="60dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/drag_handle" />

            <!-- Search Bar (Always visible in peek) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_search_background"
                android:padding="12dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search_vector"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Search icon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where to..."
                    android:textColor="@android:color/black"
                    android:textSize="18sp"/>
            </LinearLayout>

            <!-- Expanded Content Container -->
            <LinearLayout
                android:id="@+id/ll_expanded_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:visibility="invisible">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello User..."
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="normal"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Activity:"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>

            <!-- No Activity Text -->
            <TextView
                android:id="@+id/tv_no_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No activity"
                android:textAlignment="center"
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- Pending Trip Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_pending_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending Trip"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:id="@+id/iv_trip_graphic"
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_route"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="Trip route graphic"/>

                <LinearLayout
                    android:id="@+id/ll_trip_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/iv_trip_graphic"
                    app:layout_constraintStart_toEndOf="@id/iv_trip_graphic"
                    app:layout_constraintEnd_toStartOf="@id/btn_nav_cancel_container">

                    <TextView
                        android:id="@+id/tv_trip_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Starting Point: --"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_trip_dest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination: --"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Carpool Members:"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="normal"/>

                    <TextView
                        android:id="@+id/tv_dashboard_trip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No members"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_nav_cancel_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/ll_trip_details"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageButton
                        android:id="@+id/btn_nav_cancel"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_cancel"
                        android:scaleType="fitCenter"
                        android:contentDescription="Cancel trip"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leave\ncarpool"
                        android:textAlignment="center"
                        android:textColor="@android:color/black"
                        android:textSize="10sp"/>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/btn_nav_chat"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/dashboard_chat_button_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_title"
                    android:textColor="@color/earthy_dark_on_primary"
                    android:textSize="18sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/chat_button_description"
                    android:src="@drawable/bubble_chat_icon"
                    app:tint="@color/earthy_dark_on_primary" />
            </LinearLayout>

            <!-- Carpool Request Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_carpool_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/dashboard_card_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_request_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carpool Request"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:id="@+id/iv_request_graphic"
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_route"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_request_card_title"
                    app:layout_constraintStart_toStartOf="parent"
                    android:contentDescription="Request route graphic"/>

                <LinearLayout
                    android:id="@+id/ll_request_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/iv_request_graphic"
                    app:layout_constraintStart_toEndOf="@id/iv_request_graphic"
                    app:layout_constraintEnd_toStartOf="@id/btn_cancel_request_container">

                    <TextView
                        android:id="@+id/tv_request_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Starting Point: --"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_request_dest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination: --"
                        android:textColor="@android:color/black"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_request_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Status: Pending"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_cancel_request_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="@id/ll_request_details"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageButton
                        android:id="@+id/btn_cancel_request"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_cancel"
                        android:scaleType="fitCenter"
                        android:contentDescription="Cancel request"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancel\nrequest"
                        android:textAlignment="center"
                        android:textColor="@android:color/black"
                        android:textSize="10sp"/>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Action Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/btn_nav_create"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_car"
                        android:contentDescription="Create carpool icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Create\nCarpool"
                        android:textAlignment="center"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_register_vehicle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_register"
                        android:contentDescription="Register car icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Register your\nCar"
                        android:textAlignment="center"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_nav_join"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:padding="12dp"
                    android:background="@drawable/dashboard_card_background"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/ic_join"
                        android:contentDescription="Join carpool icon"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Join a\nCarpool"
                        android:textAlignment="center"
                        android:textColor="@android:color/black"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Registered Cars Section -->
            <LinearLayout
                android:id="@+id/ll_registered_cars_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Registered car"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/ll_registered_cars_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Stationary Bottom Navigation -->
    <LinearLayout
        android:id="@+id/stationary_bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:elevation="16dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home_vector"
            android:contentDescription="Home"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_calendar_vector"
            android:contentDescription="Calendar"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile_vector"
            android:contentDescription="Profile"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
