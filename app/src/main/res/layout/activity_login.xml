<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/delft_blue">

    <ImageView
        android:id="@+id/img_logo_small"
        android:layout_width="256dp"
        android:layout_height="250dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/swoopr_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_margin="24dp"
        android:background="@drawable/glass_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back..."
            android:textColor="@color/matte_ivory"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="32dp" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Email"
            android:paddingStart="16dp"
            android:background="@drawable/glass_card"
            android:backgroundTint="#20000000"
            android:layout_marginBottom="16dp"
            android:inputType="textEmailAddress" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Password"
            android:paddingStart="16dp"
            android:background="@drawable/glass_card"
            android:backgroundTint="#20000000"
            android:layout_marginBottom="8dp"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="@color/neutral_blush"
            android:layout_gravity="end"
            android:layout_marginBottom="32dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Login"
            android:background="@drawable/rounded_button"
            android:backgroundTint="@color/dull_plum"
            android:textColor="@color/matte_ivory" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>