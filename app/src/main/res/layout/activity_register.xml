<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verification_bg"
    tools:context=".RegisterActivity">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/img_welcome"
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_marginTop="32dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/big_chillin" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/thanks_choosing_us"
                android:textColor="@color/verification_text_dark"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:background="@drawable/input_background_verification"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/verification_text_dark" />

                <EditText
                    android:id="@+id/et_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:autofillHints="personName"
                    android:background="@android:color/transparent"
                    android:hint="@string/enter_your_name_label"
                    android:inputType="textPersonName"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/verification_text_dark"
                    android:textColorHint="@color/verification_text_dark"
                    android:textSize="18sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_complete_registration"
                android:layout_width="220dp"
                android:layout_height="64dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="@color/verification_button"
                android:text="@string/register"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Hidden elements for code compatibility -->
            <EditText
                android:id="@+id/et_first_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="text"
                android:visibility="gone"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />
            <EditText
                android:id="@+id/et_last_name"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="text"
                android:visibility="gone"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />
            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="phone"
                android:visibility="gone"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />
            <EditText
                android:id="@+id/et_student_id"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:inputType="text"
                android:visibility="gone"
                android:importantForAutofill="no"
                tools:ignore="LabelFor" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>