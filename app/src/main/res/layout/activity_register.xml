<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earthy_dark_background"
    tools:context=".auth.activities.RegisterActivity">

    <ImageView
        android:id="@+id/img_logo_small"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/logo_description"
        android:src="@drawable/swoopr_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_logo_small">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/glass_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:text="@string/create_account_title"
                android:textColor="@color/earthy_dark_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:text="@string/complete_profile_subtitle"
                android:textColor="@color/earthy_dark_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_first_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="personGivenName"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/first_name_hint"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <EditText
                android:id="@+id/et_last_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="personFamilyName"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/last_name_hint"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <EditText
                android:id="@+id/et_phone_number"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="phone"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/phone_number_hint"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <EditText
                android:id="@+id/et_student_id"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/student_id_hint"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="password"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:autofillHints="password"
                android:background="@drawable/glass_card"
                android:backgroundTint="#20000000"
                android:hint="@string/confirm_password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/earthy_dark_text_primary"
                android:textColorHint="@color/earthy_dark_text_disabled" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_complete_registration"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/rounded_button"
                android:backgroundTint="@color/earthy_dark_primary"
                android:text="@string/finish_button"
                android:textAllCaps="false"
                android:textColor="@color/earthy_dark_on_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>