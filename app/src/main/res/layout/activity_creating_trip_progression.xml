<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_green_bg"
    tools:context=".CreatingTripProgression">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/sheet_anchor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.41" />

    <FrameLayout
        android:id="@+id/map_preview_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#D8E3EA"
        app:layout_constraintBottom_toTopOf="@id/sheet_anchor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map_preview_fragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/sheet_anchor"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/progression_map_control_background"
            android:contentDescription="@string/trip_map_layer"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_mapmode"
            app:tint="#F5F5F5" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/progression_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bottom_sheet_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/sheet_anchor">

        <View
            android:layout_width="96dp"
            android:layout_height="6dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/drag_handle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="@string/trip_creating_title"
            android:textColor="@android:color/black"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/dashboard_card_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_pending_trip"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_pending_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_pending"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_vehicle_validation"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_vehicle_validation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_ownership"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_geofence_validation"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_geofence_validation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_geofence"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_neighborhood_resolution"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_neighborhood_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_neighborhood"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_route_resolution"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_route_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_route_resolution"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/icon_trip_finalization"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/trip_status_pending"
                    android:src="@android:drawable/presence_invisible" />

                <TextView
                    android:id="@+id/text_trip_finalization"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/trip_step_finalization"
                    android:textColor="@android:color/black"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/registration_button_background"
            android:drawablePadding="12dp"
            android:drawableStart="@drawable/ic_arrow_left"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/trip_go_home"
            android:textAllCaps="false"
            android:textColor="#D5D5D5"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_home_description"
                android:src="@drawable/ic_home_vector"
                app:tint="#1F1F1F" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_calendar_description"
                android:src="@drawable/ic_calendar_vector"
                app:tint="#1F1F1F" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:contentDescription="@string/nav_profile_description"
                android:src="@drawable/ic_profile_vector"
                app:tint="#1F1F1F" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>